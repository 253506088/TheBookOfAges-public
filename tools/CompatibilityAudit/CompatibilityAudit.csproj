<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    <ItemGroup>
        <Reference Include="0Harmony" HintPath="$(GameDataPath)/0Harmony.dll" />
    </ItemGroup>
    <Target Name="CheckGameData" BeforeTargets="ResolveReferences">
        <Error Text="请使用 -p:GameDataPath 指定目标游戏程序集目录。" Condition="!Exists('$(GameDataPath)/0Harmony.dll')" />
    </Target>
</Project>
